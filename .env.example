# HireTitan configuration template. Copy to .env and adjust. Never commit .env.
# API keys live only here (never in the database). The setup wizard checks the key
# with a test call. If a key expires, update it here and restart.
# The final list is defined in feature 001 (setup-and-profile).

# LLM provider key (OpenAI first; other providers come before the public release)
OPENAI_API_KEY=

# Where HireTitan keeps its data (database volume, uploaded resumes, exports)
HIRETITAN_DATA_DIR=./data

# PostgreSQL (used by docker compose)
POSTGRES_USER=hiretitan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hiretitan

# Local only: the API binds to localhost
HIRETITAN_HOST=127.0.0.1
HIRETITAN_PORT=8000
