# HireTitan configuration template. Copy to .env and adjust. Never commit .env.
# API keys live only here (never in the database) and are never logged (FR-029).
# If a key is missing or rejected, AI tasks pause; fix it here, restart, and press
# "Check again" in Settings.

# --- AI ----------------------------------------------------------------------
# OpenAI API key. Leave empty to use HireTitan without AI (manual profile entry).
OPENAI_API_KEY=
# LLM mode: "openai" (real calls) or "fake" (scripted replies for tests/CI/demos).
HIRETITAN_LLM=openai
# Folder of scripted replies (<task>.json files) used when HIRETITAN_LLM=fake.
HIRETITAN_FAKE_LLM_DIR=

# --- Job boards --------------------------------------------------------------
# "real" reads company job boards through the bundled career-ops; "fake" answers from the
# files in HIRETITAN_FAKE_CAREER_OPS_DIR (<vendor>__<board_id>.json) for tests and demos.
HIRETITAN_CAREER_OPS=real
HIRETITAN_FAKE_CAREER_OPS_DIR=

# --- Data --------------------------------------------------------------------
# Where HireTitan keeps uploaded resumes and exports.
HIRETITAN_DATA_DIR=./data

# --- PostgreSQL --------------------------------------------------------------
# Used by docker compose and to build the database URL.
POSTGRES_USER=hiretitan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hiretitan
# "db" inside docker compose; 127.0.0.1 when running the backend on the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: a full SQLAlchemy URL (postgresql+psycopg://...) that overrides the
# POSTGRES_* values above.
DATABASE_URL=

# --- Server ------------------------------------------------------------------
# Local only: the API binds to localhost. There is no login, so don't expose it.
HIRETITAN_HOST=127.0.0.1
HIRETITAN_PORT=8000
# Folder of the built web app. Set by the Docker image; leave empty otherwise.
HIRETITAN_FRONTEND_DIST=
