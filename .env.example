# HireTitan configuration template. Copy to .env and adjust.
# Most settings (LLM provider, API key, budget) are entered in the first-run setup
# wizard instead; values here are optional overrides. The final list is defined in
# feature 001 (setup-and-profile).

# Where HireTitan keeps its data (database volume, uploaded resumes, exports)
HIRETITAN_DATA_DIR=./data

# PostgreSQL (used by docker compose)
POSTGRES_USER=hiretitan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hiretitan

# Local only: the API binds to localhost
HIRETITAN_HOST=127.0.0.1
HIRETITAN_PORT=8000
