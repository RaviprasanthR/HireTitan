# Constitution VI: layer and module boundaries (plan.md, "Import-linter contracts").
# Checked in CI with `lint-imports` and by tests/architecture/test_import_contracts.py.

[importlinter]
root_package = hiretitan
include_external_packages = True

# 1. Layers per feature module: api -> workflow -> infra -> application -> domain.
#    A layer may import only the layers below it, so infra imports application and
#    domain only, and domain imports nothing above it. Not every module has a workflow.
[importlinter:contract:feature-layers]
name = Feature modules are layered api > workflow > infra > application > domain
type = layers
containers =
    hiretitan.profile
    hiretitan.preferences
    hiretitan.setup
    hiretitan.search
    hiretitan.drafts
layers =
    api
    (workflow)
    infra
    application
    domain

# 2. Feature domains stay pure: no frameworks, persistence, AI SDKs, settings or runtime.
[importlinter:contract:pure-domain]
name = Feature domains import no frameworks, persistence, AI SDKs, settings or runtime
type = forbidden
source_modules =
    hiretitan.profile.domain
    hiretitan.preferences.domain
    hiretitan.setup.domain
    hiretitan.search.domain
    hiretitan.drafts.domain
    hiretitan.mail.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    langgraph
    procrastinate
    openai
    pydantic_settings
    hiretitan.platform.runtime

# 3. Feature modules talk to each other only through <module>.application.
[importlinter:contract:profile-boundary]
name = profile uses other modules only through their application layer
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.profile
forbidden_modules =
    hiretitan.preferences.domain
    hiretitan.preferences.infra
    hiretitan.preferences.api
    hiretitan.setup.domain
    hiretitan.setup.infra
    hiretitan.setup.api
    hiretitan.search.domain
    hiretitan.search.infra
    hiretitan.search.workflow
    hiretitan.search.api
    hiretitan.drafts.domain
    hiretitan.drafts.infra
    hiretitan.drafts.workflow
    hiretitan.drafts.api
    hiretitan.mail.domain
    hiretitan.mail.infra
    hiretitan.mail.workflow
    hiretitan.mail.api

[importlinter:contract:preferences-boundary]
name = preferences uses other modules only through their application layer
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.preferences
forbidden_modules =
    hiretitan.profile.domain
    hiretitan.profile.infra
    hiretitan.profile.workflow
    hiretitan.profile.api
    hiretitan.setup.domain
    hiretitan.setup.infra
    hiretitan.setup.api
    hiretitan.search.domain
    hiretitan.search.infra
    hiretitan.search.workflow
    hiretitan.search.api
    hiretitan.drafts.domain
    hiretitan.drafts.infra
    hiretitan.drafts.workflow
    hiretitan.drafts.api
    hiretitan.mail.domain
    hiretitan.mail.infra
    hiretitan.mail.workflow
    hiretitan.mail.api

[importlinter:contract:setup-boundary]
name = setup uses other modules only through their application layer
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.setup
forbidden_modules =
    hiretitan.profile.domain
    hiretitan.profile.infra
    hiretitan.profile.workflow
    hiretitan.profile.api
    hiretitan.preferences.domain
    hiretitan.preferences.infra
    hiretitan.preferences.api
    hiretitan.search.domain
    hiretitan.search.infra
    hiretitan.search.workflow
    hiretitan.search.api
    hiretitan.drafts.domain
    hiretitan.drafts.infra
    hiretitan.drafts.workflow
    hiretitan.drafts.api
    hiretitan.mail.domain
    hiretitan.mail.infra
    hiretitan.mail.workflow
    hiretitan.mail.api

[importlinter:contract:search-boundary]
name = search uses other modules only through their application layer
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.search
forbidden_modules =
    hiretitan.profile.domain
    hiretitan.profile.infra
    hiretitan.profile.workflow
    hiretitan.profile.api
    hiretitan.preferences.domain
    hiretitan.preferences.infra
    hiretitan.preferences.api
    hiretitan.setup.domain
    hiretitan.setup.infra
    hiretitan.setup.api
    hiretitan.drafts.domain
    hiretitan.drafts.infra
    hiretitan.drafts.workflow
    hiretitan.drafts.api
    hiretitan.mail.domain
    hiretitan.mail.infra
    hiretitan.mail.workflow
    hiretitan.mail.api

# 4. The shared platform never depends on a feature module.
[importlinter:contract:platform-independent]
name = platform never imports feature modules
type = forbidden
source_modules =
    hiretitan.platform
forbidden_modules =
    hiretitan.profile
    hiretitan.preferences
    hiretitan.setup
    hiretitan.search
    hiretitan.drafts
    hiretitan.mail

# 5. Feature 002b (FR-022, research R9): contacts and notes are the person's own data and never
#    reach an AI prompt. The search workflow, the prompts and the LLM platform may not import the
#    contacts or notes code (checked on direct imports; the workflow may still use
#    the companies use cases that count contacts).
[importlinter:contract:contacts-stay-out-of-ai-paths]
name = workflows, prompts and the LLM platform never import contacts code
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.search.workflow
    hiretitan.drafts.workflow
    hiretitan.prompts
    hiretitan.platform.llm
forbidden_modules =
    hiretitan.search.domain.contacts
    hiretitan.search.application.contacts
    hiretitan.search.domain.interviews
    hiretitan.search.application.interviews
    hiretitan.search.infra.interviews_repo
    hiretitan.search.domain.resume_choice
    hiretitan.search.application.resume_choice
    hiretitan.search.infra.pipeline_settings_repo

# 6. Feature 002k: the drafts module reads the profile, the jobs and the contacts only through the
#    ports in drafts.application, which hiretitan/drafts_wiring.py implements. It imports no other
#    feature module at all.
[importlinter:contract:drafts-boundary]
name = drafts imports no other feature module (it uses ports wired at the composition root)
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.drafts
forbidden_modules =
    hiretitan.profile
    hiretitan.preferences
    hiretitan.setup
    hiretitan.search
    hiretitan.mail

# 7. Feature 002c: the mail module reads the person's own mail and is reusable by later mail
#    features. It imports no other feature module; hiretitan/mail_wiring.py joins it to the rest at
#    the composition root, through ports in mail.application.
[importlinter:contract:mail-boundary]
name = mail imports no other feature module (it uses ports wired at the composition root)
type = forbidden
allow_indirect_imports = True
source_modules =
    hiretitan.mail
forbidden_modules =
    hiretitan.profile
    hiretitan.preferences
    hiretitan.setup
    hiretitan.search
    hiretitan.drafts

# 8. The mail module is layered like the others. Its application, workflow and api layers arrive
#    task by task (002c), so every layer is optional until then.
[importlinter:contract:mail-layers]
name = mail is layered api > workflow > infra > application > domain
type = layers
containers =
    hiretitan.mail
layers =
    (api)
    (workflow)
    (infra)
    (application)
    (domain)
